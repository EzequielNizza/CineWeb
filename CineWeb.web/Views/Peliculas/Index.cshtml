@using Cine.Web.Modelos
@model List<PeliculaVM>

<table class="table table-striped table-bordered w-100 align-middle">
	<thead class="table-dark">
		<tr>
			<th>Título</th>
			<th>Descripción</th>
			<th>Duración (Min)</th>
			<th>Acciones</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var pelicula in Model)
		{
			<tr>
				<td>@pelicula.Titulo</td>
				<td>@pelicula.Descripcion</td>
				<td>@pelicula.DuracionMin</td>
				<td>
					@if (User.HasClaim("Permiso", "peliculas.ver"))
					{
						<a href="/Peliculas/Ver/@pelicula.Id">Ver</a>
					}
					@if (User.HasClaim("Permiso", "peliculas.editar"))
					{
						<a href="/Peliculas/Editar/@pelicula.Id">Editar</a>
					}
					@if (User.HasClaim("Permiso", "peliculas.eliminar"))
					{
						<a href="/Peliculas/Borrar/@pelicula.Id">Borrar</a>
					}
				</td>
			</tr>
		}
	</tbody>
</table>

