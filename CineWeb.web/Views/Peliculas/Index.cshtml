@using Cine.Web.Models
@model List<PeliculaVM>

<h1>Index de Películas</h1>
<a href="/Peliculas/Agregar">Agregar Película</a>
<table style="font-size:24px">
	<tr>
		<th>Titulo</th>
		<th>Fecha</th>
		<th>Duración</th>
		<th>Precio</th>
	</tr>

	@foreach (var pelicula in Model)
	{
		<tr>
			<td><a href="/Peliculas/Editar/@pelicula.Id">Editar</a>
				<a href="/Peliculas/Ver/@pelicula.Id">Ver</a>
			</td>
			<td>@pelicula.Titulo</td>
			<td>@pelicula.FechaFuncion</td>
			<td>@pelicula.DuracionMin</td>
			<td>@pelicula.Precio</td>
		</tr>

	}

</table>