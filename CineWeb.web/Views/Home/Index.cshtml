@{
	ViewData["Title"] = "Home Page";
}

<div class="text-center">
	<h1 class="display-4">Bienvenido</h1>
</div>

@if (User.Identity.IsAuthenticated)
{
	<h3> Hola @User.Identity.Name</h3>
	<p>Sus permisos:</p>
	<ul>
		@foreach (var claim in User.Claims)
		{

			if (claim.Type == "Permiso")
			{
				<li> @claim.Value </li>
			}
		}

    
	</ul>
	<a asp-action="logout" asp-controller="login"> Cerrar Sesión</a>

}
else
{
	<a asp-action="login" asp-controller="login"> Iniciar Sesión</a>
}


