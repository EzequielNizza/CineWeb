@using Cine.Web.Modelos
@model List<EntradaVM>

<table class="table table-striped table-bordered w-100 align-middle">
	<thead class="table-dark">
		<tr>
			<th>ID Entrada</th>
			<th>Película</th>
			<th>Sala</th>
			<th>Fecha Función</th>
			<th>Precio</th>
			<th>Fecha Compra</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var entrada in Model)
		{
			<tr>
				<td>@entrada.IdEntrada</td>
				<td>@entrada.TituloPelicula</td>
				<td>@entrada.IdSala</td>
				<td>@entrada.FechaHoraFuncion.ToString("dd/MM/yyyy HH:mm")</td>
				<td>$@entrada.PrecioEntrada</td>
				<td>@entrada.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
			</tr>
		}
	</tbody>
</table>