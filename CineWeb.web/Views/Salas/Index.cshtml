@using Cine.Web.Modelos
@model List<SalaVM>

<h1>Index de Salas</h1>
	@if (User.HasClaim("Permiso", "salas.crear"))
{
	<a href="/Salas/Agregar">Agregar Sala</a>
}

<table class="table table-striped table-bordered w-100 align-middle">
	<thead class="table-dark">
		<tr>
			<th>ID</th>
			<th>Cantidad de Butacas</th>
			<th>Acciones</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var sala in Model)
		{
			<tr>
				<td>@sala.IdSala</td>
				<td>@sala.CantidadButacas</td>
				<td>
					@if (User.HasClaim("Permiso", "salas.ver"))
					{
						<a href="/Salas/Ver/@sala.IdSala">Ver</a>
					}
					@if (User.HasClaim("Permiso", "salas.editar"))
					{
						<a href="/Salas/Editar/@sala.IdSala">Editar</a>
					}
					@if (User.HasClaim("Permiso", "salas.eliminar"))
					{
						<a href="/Salas/Borrar/@sala.IdSala">Borrar</a>
					}
				</td>
			</tr>
		}
	</tbody>
</table>


